# ---------------------------------------------------------------------------
# MemeVerdict — environment variables (SAFE PLACEHOLDERS ONLY)
# ---------------------------------------------------------------------------
# Copy this file to `.env` (at the repo root — Vite reads it automatically).
# `.env` is git-ignored — never commit it, never paste secrets into it.
#
# For the current LIVE MemeVerdict v2 deployment, the values below are the
# real, non-secret ones and can be pasted straight into `.env` for local
# development or for the frontend host's build settings.
# ---------------------------------------------------------------------------

# GenLayer Studio RPC endpoint
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Studio chain metadata used by MetaMask when the network is
# auto-added / auto-switched from the frontend.
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_CHAIN_NAME=GenLayer Studio
VITE_GENLAYER_SYMBOL=GEN

# The OFFICIAL live MemeVerdict v2 contract on GenLayer Studio.
# Deployed 2026-09-03 — see docs/deployment.md for the deployment /
# consensus transaction hashes.
VITE_MEMEVERDICT_CONTRACT_ADDRESS=0x96a9B51C30a0Af126C7d4594489e2940F1f44621

# ---------------------------------------------------------------------------
# OPTIONAL — for the Python deployment scripts (not used by the frontend).
# Keep BLANK in this checked-in example file. Fill it only in a local `.env`
# that is git-ignored.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
